# Copy to qemu/local.env (gitignored) on a machine where auto-detection in
# qemu/common.sh picks the wrong thing. Plain bash, sourced by the qemu scripts;
# environment variables still override it.

# Rust-enabled kernel build dir (scripts/build_kernel.sh, docs/setup.md).
#KERNEL=$HOME/WS/linux_ktvmx

# Raw ext4 root disk with sshd and root key login (syzkaller create-image.sh style).
#DISK=$HOME/WS/stretch-image/bookworm.img
#DISK=/data/debian-img/trixie.img

# Defaults to $DISK with .img replaced by .id_rsa.
#SSH_KEY=

# Pick another port if 10021 is taken (e.g. a second VM on the same machine).
#PORT=10021
#MEM=2G
